{
  "name": "expense-tracker",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "clean": "rm -rf .next/cache",
    "postinstall": "prisma generate",
    "k6": "C:\\PROGRA~1\\k6\\k6.exe",
    "stress": "npm run k6 -- run tests/k6/full_scenario.js",
    "stress:runner": "npm run k6 -- run tests/k6/runner.js",
    "stress:health": "npm run k6 -- run tests/k6/health.js",
    "stress:stats": "npm run k6 -- run tests/k6/stats.js",
    "stress:tokens": "npm run k6 -- run tests/k6/tokens.js",
    "stress:phase1": "npm run k6 -- run --vus 5 --duration 30s tests/k6/full_scenario.js && npm run k6 -- run --vus 10 --duration 1m tests/k6/full_scenario.js && npm run k6 -- run --vus 20 --duration 1m tests/k6/full_scenario.js",
    "stress:phase2": "npm run k6 -- run --vus 30 --duration 2m tests/k6/full_scenario.js",
    "stress:phase3": "npm run k6 -- run --vus 50 --duration 2m tests/k6/full_scenario.js && npm run k6 -- run --vus 100 --duration 2m tests/k6/health.js",
    "stress:idor": "npm run k6 -- run tests/k6/idor.js",
    "stress:all": "npm run stress:phase1 && npm run stress:phase2 && npm run stress:phase3"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.9.2",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@upstash/ratelimit": "^2.0.8",
    "canvas": "^3.2.3",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.38.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.8.0",
    "mariadb": "^3.5.2",
    "mysql2": "^3.22.3",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.1.4",
    "eslint-plugin-security": "^4.0.1",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
