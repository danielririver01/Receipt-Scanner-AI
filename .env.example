# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_tu-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_tu-clerk-secret-key

# Database (misma DB que Orderfox - MySQL)
DATABASE_URL=mysql+pymysql://usuario:contraseña@host:puerto/nombre_db
DIRECT_URL=mysql://usuario:contraseña@host:puerto/nombre_db

# DeepSeek (estructuración de datos del OCR)
DEEPSEEK_API_KEY=sk-tu-deepseek-api-key

# Google Vision (OCR alternativo)
GOOGLE_VISION_API_KEY=tu-google-vision-api-key

# Cloudinary (imágenes de recibos)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Flask / Orderfox (comunicación servidor a servidor)
FLASK_SECRET_KEY=tu-flask-secret-key
ORDERFOX_URL=https://velzia.shop
SERVICE_API_KEY=tu-service-api-key
NEXT_PUBLIC_FLASK_REGISTER_URL=https://velzia.shop/register
